# Copy this file to .env and fill in your actual keys
# Never commit .env to version control

# Optional shared API key for protecting backend API endpoints in deployed demos.
# If set, frontend requests must send the same value as REACT_APP_API_KEY.
APP_API_KEY=change-me-for-deployed-demo

# Anthropic — supervisor (Haiku) + specialist (Sonnet) when using the Anthropic block in nodes.py
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_SUPERVISOR_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_SPECIALIST_MODEL=claude-sonnet-4-20250514

# OpenAI — validator (gpt-4o-mini) + Chroma embeddings (text-embedding-3-small)
# The embedding key is always required; the validator key is only needed for the OpenAI validator block.
OPENAI_API_KEY=sk-your-key-here
OPENAI_VALIDATOR_MODEL=gpt-4o-mini

# Frontend only: copy into frontend/.env.local or your hosting environment.
REACT_APP_API_KEY=change-me-for-deployed-demo

# Google / Gemini — swap supervisor + specialist + validator to Gemini by uncommenting
# the Gemini block in backend/agent/nodes.py. Instalily is Google/DeepMind aligned.
GOOGLE_API_KEY=your-gemini-api-key-here
